# Supabase project settings (Project Settings > API, or `npx supabase status` for local)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Public site URL, used for auth email redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: server-only Supabase secret (service role) key. Needed for LINE notifications.
SUPABASE_SECRET_KEY=
# Optional: LINE Messaging API (LINE Developers > Messaging API channel).
# Webhook URL: <site>/api/line/webhook
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
LINE_BOT_BASIC_ID=
